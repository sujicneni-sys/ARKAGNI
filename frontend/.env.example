# Copy to .env (git-ignored) only when the API is NOT served from this origin.
#
# Default behaviour with no file: every request is relative ("/health",
# "/harmonize", ...), which is what the single-service Render deployment does
# because FastAPI serves frontend/dist itself.
#
# Set one of these to point the dashboard at an API on another host, e.g.
#   VITE_API_URL=https://arkagni-api.onrender.com
# No trailing slash is required; one is stripped if present.

VITE_API_URL=
VITE_API_BASE=
