# Python / Virtual Environments
__pycache__/
*.py[cod]
.venv/
env/
venv/

# Local environment overrides (never commit real secrets or hosts)
.env
.env.local
.env.*.local

# JavaScript dependencies and build output are regenerated by npm ci / npm run build
node_modules/
frontend/node_modules/
frontend/tsconfig.tsbuildinfo
