# IDE and System Files
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini

# Large data files: the ~296 MB data.db stays out of git (GitHub rejects files
# over 100 MB). Rebuild it with scripts/05_build_database.py, or attach it to a
# release as data.db.gz and let backend/store.py expand it at startup.
*.csv
*.zip
*.tar
*.gz
data.db
